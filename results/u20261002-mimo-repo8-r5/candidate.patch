+    def _expand_backwards_plan(self, plan):
+        """
+        Expand a backwards plan so that unapplying a replacement (squashed)
+        migration also unapplies the migrations it replaces, if those are
+        still recorded as applied in the database.
+        """
+        applied = self.recorder.applied_migrations()
+        expanded = []
+        seen = set()
+        for migration, backwards in plan:
+            key = (migration.app_label, migration.name)
+            if backwards and key in self.loader.replacements:
+                replaced = self.loader.replacements[key].replaces
+                for replaced_key in replaced:
+                    if replaced_key in applied and replaced_key not in seen:
+                        replaced_migration = self.loader.disk_migrations.get(replaced_key)
+                        if replaced_migration is not None:
+                            expanded.append((replaced_migration, True))
+                            seen.add(replaced_key)
+            if key not in seen:
+                expanded.append((migration, backwards))
+                seen.add(key)
+        return expanded
